# ---------------------------------------------------------------------------
# IronQuest — variables d'environnement
#
# TOUTES SONT FACULTATIVES. Sans elles, l'application fonctionne intégralement
# en local (localStorage) : aucun compte, aucun serveur, aucune configuration.
#
# Copiez ce fichier vers .env.local pour activer la synchronisation Supabase.
# ---------------------------------------------------------------------------

# URL du projet Supabase, visible dans Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » du projet, visible au même endroit.
# Elle est exposée au navigateur : c'est attendu, la sécurité repose sur les
# politiques RLS définies dans supabase/schema.sql.
# N'utilisez JAMAIS la clé service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
