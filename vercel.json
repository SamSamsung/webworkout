{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "comment": "Le service worker ne doit jamais être servi depuis un cache : sinon une ancienne version continue de piloter le site après un déploiement.",
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "comment": "Les icônes et le manifeste changent rarement et sont versionnés par le déploiement.",
      "source": "/(icon-.*\\.png|apple-touch-icon\\.png|manifest\\.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "comment": "En-têtes de sécurité de base : le site ne charge aucune ressource tierce.",
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
